# ====================================
# IMMOBILIER PLURIEL - .env EXAMPLE
# ====================================
# Copier ce fichier en .env et remplir avec vos valeurs réelles
# ⚠️ JAMAIS commiter le fichier .env en production

# ==== APPLICATION ====
APP_NAME="Immobilier Pluriel"
APP_ENV=production
APP_KEY=base64:VOTRE_CLE_GENEREE_PAR_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://www.immobilierpluriel.com

# ==== LOCALE ====
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ==== LOG ====
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ==== DATABASE ====
# SQLite (développement)
# DB_CONNECTION=sqlite

# MySQL/MariaDB (production - recommandé)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=immobilier_pluriel
DB_USERNAME=immobilier_user
DB_PASSWORD=votre_mot_de_passe_securise

# ==== SESSION ====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ==== CACHE ====
CACHE_STORE=database

# ==== QUEUE ====
QUEUE_CONNECTION=database

# ==== MAIL ====
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=votre_username_mailtrap
MAIL_PASSWORD=votre_password_mailtrap
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@immobilierpluriel.com
MAIL_FROM_NAME="Immobilier Pluriel"

# Alternative: SendGrid
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=votre_sendgrid_api_key

# Alternative: Mailgun
# MAIL_MAILER=mailgun
# MAILGUN_DOMAIN=votre_mailgun_domain
# MAILGUN_SECRET=votre_mailgun_secret

# ==== AWS S3 (pour les uploads) ====
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=immobilier-pluriel
AWS_URL=https://s3.eu-west-1.amazonaws.com/immobilier-pluriel
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==== VITE ====
VITE_APP_NAME="Immobilier Pluriel"
VITE_API_URL=https://www.immobilierpluriel.com/api

# ==== AUTRES SERVICES ====
# Google Analytics
GOOGLE_ANALYTICS_ID=

# Facebook Pixel
FACEBOOK_PIXEL_ID=

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=

# ==== DÉVELOPPEMENT (local uniquement) ====
# DEBUG_BAR=true
# DUMP_SERVER_HOST=127.0.0.1
# DUMP_SERVER_PORT=9912
